---
import Layout from '../layouts/Layout.astro';
import WaitlistForm from '../components/WaitlistForm.astro';

const faqs = [
  {
    q: 'What does SafeScreen do?',
    a: 'It checks what appears on your screen and blurs harmful and explicit imagery before you see it, in any app. You get a label and a tap-to-reveal button, so the final call is always yours.',
  },
  {
    q: 'What exactly does it detect?',
    a: 'Explicit and pornographic imagery, and graphic violence. Anything a kid shouldn’t stumble onto. Text moderation isn’t part of v1.',
  },
  {
    q: 'Does my screen get uploaded anywhere?',
    a: 'No. The AI runs entirely on your phone. Each frame is analyzed on the spot and immediately discarded. Detection even works in airplane mode, which is the proof it doesn’t depend on a server.',
  },
  {
    q: 'Do I need an account?',
    a: 'Signing up takes an email address, and that’s all the account ever holds. What appears on your screen is never tied to it.',
  },
  {
    q: 'Will it ever blur the wrong thing?',
    a: 'Sometimes, yes. No detector is perfect: occasionally it will blur something innocent, or miss something it shouldn’t. Every blur is one tap from reversal, and you control the sensitivity, from relaxed to strict.',
  },
  {
    q: 'Does it report, delete, or block anything on its own?',
    a: 'Never. SafeScreen blurs and labels. It doesn’t delete content, doesn’t report anyone, and doesn’t notify anybody about what you reveal.',
  },
  {
    q: 'Which phones does it work on?',
    a: 'SafeScreen launches on modern Android phones first, with iOS on the way. It uses your phone’s AI chip where available and falls back to the regular processor automatically.',
  },
  {
    q: 'How do I get it?',
    a: 'Join the waitlist below and we’ll email you once when it launches. No spam.',
  },
];
---

<Layout
  title="FAQ | SafeScreen"
  description="Common questions about SafeScreen: what it detects, where the AI runs, accuracy, accounts, and platforms."
>
  <section class="container-tight pt-20 pb-4 sm:pt-28">
    <p class="eyebrow">FAQ</p>
    <h1 class="mt-5 max-w-3xl text-[2.4rem] font-bold leading-[1.06] tracking-[-0.03em] sm:text-5xl">
      Questions people actually ask.
    </h1>
  </section>

  <section class="container-tight mt-12">
    <div class="max-w-2xl overflow-hidden rounded-xl border border-line">
      {
        faqs.map((f, i) => (
          <div class:list={['p-7', i > 0 && 'border-t border-line']}>
            <h2 class="text-lg font-600 text-fg">{f.q}</h2>
            <p class="mt-2 leading-relaxed text-fg-2">{f.a}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section id="waitlist" class="container-tight mt-24">
    <div class="card flex flex-col items-start gap-7 p-10 sm:p-14">
      <h2 class="text-3xl sm:text-4xl">Anything else? Ask us directly.</h2>
      <p class="-mt-3 text-fg-2">
        <a href="mailto:info@mysafescreen.com" class="link-accent">info@mysafescreen.com</a>, or get on the
        list and we'll email you at launch.
      </p>
      <WaitlistForm />
    </div>
  </section>
</Layout>
